{
  "name": "takasumibot-toolkit",
  "version": "0.1.0-beta.1",
  "description": "TypeScript client SDK for the TakasumiBOT public API (v3)",
  "keywords": [
    "takasumibot",
    "takasumi",
    "toolkit",
    "tool",
    "api",
    "client",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "Yamatomato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yamatomato0105/takasumibot-toolkit-js.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "TakasumiBOT-OpenAPI-Document.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript TakasumiBOT-OpenAPI-Document.json -o src/generated/openapi.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^5.0.4"
  }
}
